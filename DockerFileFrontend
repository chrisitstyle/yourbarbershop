FROM node:22-alpine
WORKDIR /frontend

# copy lockfiles first to leverage docker layer caching for deps
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile

# copy app sources after deps to avoid reinstalling on every code change
COPY frontend/ ./

EXPOSE 3000

# bind to 0.0.0.0 so the dev server is reachable from outside the container
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0", "--port", "3000"]